{
  "name": "mkv-player-workspace",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:player": "npm run dev --workspace @mkv/player",
    "build:player": "npm run build --workspace @mkv/player",
    "preview:player": "npm run preview --workspace @mkv/player",
    "upload:r2": "npm run upload:r2 --workspace @mkv/player --"
  }
}
